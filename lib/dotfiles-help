#!/usr/bin/env bash

set -euo pipefail
IFS=$'\n\t'

echo "Usage: dotfiles <command> [<options>]

Dotfiles tool will manage installation and configuration.

Commands:
   install                                 Search for all install.sh files and execute it
   install-plugin <DOTFILES_GIT_URL>       Install a given plugin, it take the git repository of the plugin as the parameter
   update-plugin <PLUGIN_NAME>             Update a given plugin
   uninstall-plugin <PLUGIN_NAME>          Uninstall a given plugin
   create-plugin <PLUGIN_NAME>             Create a plugin using the base template
   plugins                                 Shows all plugins installed
   update                                  Update to latest version of dotfiles
   uninstall                               Search for all uninstall.sh files and execute it
   apply                                   Search for all install.sh files and execute it.
                                           Search for all *.symlink and create symbolic links into \$HOME
                                           Search for all executables inside 'bin' folders and make it available from \$PATH.
   version                                 Display the version

Options:
   --skip-deps-installation                Apply configuration without installing dependencies (Homebrew).
                                           Available on: install, update, update-plugin, apply.
                                           Equivalent to setting DOTFILES_SKIP_DEPS_INSTALLATION=true.
   --no-reload                             Do not open a new shell session at the end.
                                           Available on: update, update-plugin, install-plugin, uninstall-plugin.
                                           Equivalent to setting DOTFILES_NO_RELOAD=1.

Configuration:
   Settings are read from ~/.dotfiles.json (see dotfiles.json.example). The path
   can be changed with DOTFILES_CONFIG_FILE. Environment variables take
   precedence over the file. Keys and defaults:

   debug                 false   Print debug messages (DOTFILES_DEBUG)
   skipDepsInstallation  false   Skip Homebrew dependency installation (DOTFILES_SKIP_DEPS_INSTALLATION)
   noReload              0       Do not open a new shell after commands (DOTFILES_NO_RELOAD)
   os.updateOs           false   Run macOS software updates (DOTFILES_OS_UPDATE_OS)
   os.enableDoctor       false   Run brew doctor after installing (DOTFILES_OS_ENABLE_DOCTOR)
   os.enableBrewCleanup  false   Remove brew apps not in the Brewfile (DOTFILES_OS_ENABLE_BREW_CLEANUP)
   os.upgradeApps        true    Run brew update/upgrade/cleanup on install and update (DOTFILES_OS_UPGRADE_APPS)
"
